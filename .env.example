# --- Docker Postgres (read by docker-compose.yml) ---
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_generate
# Use another port (e.g. 5433) if a native PostgreSQL service already uses 5432.
POSTGRES_PORT=5432

# --- App ---
# Must match the values above.
DATABASE_URL=postgres://resume:resume@localhost:5432/resume_generate

# Backend reaches the DB through ngrok http -> wsproxy (npm run db:tunnel).
# The proxy always targets db:5432, so DATABASE_URL's host is ignored when this is set;
# user/password/database are still used. Empty it for a direct postgres-js connection.
DATABASE_WS_PROXY=keenly-ivory-blatancy.ngrok-free.dev/v1

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Set to "true" only when running behind a reverse proxy you control,
# so X-Forwarded-For is trusted for rate limiting.
TRUST_PROXY=false

# 32-byte base64 key used to encrypt users' OpenAI API keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=ypbGiAWeyX8LYf04iFuEn7xpr1jquXE5uE60GabCgPo=

# OpenAI endpoint and the model used when a user hasn't picked one.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4.1-mini

# PDF rendering uses headless Google Chrome / Chromium (auto-detected).
# CHROME_PATH=/usr/bin/google-chrome
# Set to true only when running as root or in Docker.
CHROME_NO_SANDBOX=false

# Admin account created/updated by `npm run admin:create`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD='hjiyj896*9kgtOI(0lhf67jLhfg'

# --- Google reCAPTCHA v2 (login + register) ---
# These are Google's official TEST keys: the checkbox always passes and shows a
# "for testing purposes only" note. Replace both with your own keys
# (https://www.google.com/recaptcha/admin, type "v2 checkbox") before going live.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- Email (SMTP) for the 6-digit sign-up code ---
# Fill these in to send real emails. While SMTP_HOST is empty, development
# prints the code in the `npm run dev` terminal instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Resume Generate <no-reply@example.com>"
